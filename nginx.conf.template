# nginx.conf template for Athena and its account preference service.
# ${HERMES_GATEWAY_URL} and ${HERMES_HOME} are substituted by
# scripts/runtime-config.mjs at container start; every other $var is nginx's own.

pid "${HERMES_STATE_DIR}/nginx.pid";
error_log stderr;
events {}

http {
    include /etc/nginx/mime.types;
    # Categories preserve diagnostics without logging URLs, query strings,
    # conversation IDs, cookies, authorization headers, or referrers.
    map $request_uri $athena_route {
        default app;
        ~^/api/ws(?:/|\?|$) websocket;
        ~^/api(?:/|\?|$) api;
        ~^/auth(?:/|\?|$) auth;
        ~^/login(?:/|\?|$) login;
        ~^/(?:desktop-plugins|plugins)(?:/|\?|$) plugins;
        ~^/assets(?:/|\?|$) assets;
        ~^/(?:runtime-config|gateway-config)\.js(?:\?|$) runtime_config;
        ~^/build-info\.json(?:\?|$) build_info;
        ~^/(?:sw|notifications-sw|update-coordinator-sw)\.js(?:\?|$) service_worker;
    }
    log_format athena escape=json
        '{"time":"$time_iso8601","service":"athena","event":"request",'
        '"method":"$request_method","route":"$athena_route","status":$status,'
        '"bytes":$body_bytes_sent,"request_seconds":$request_time,'
        '"upstream_status":"$upstream_status","upstream_seconds":"$upstream_response_time"}';
    access_log /dev/stdout athena;
    client_body_temp_path "${HERMES_STATE_DIR}/client";
    proxy_temp_path "${HERMES_STATE_DIR}/proxy";
    default_type application/octet-stream;

    # Upgrade/Connection map needed for the /api/ws WebSocket proxy.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # A TLS-terminating reverse proxy (such as Cloudflare) may connect to this
    # nginx over HTTP while the browser is using HTTPS. Preserve its original
    # scheme so the gateway builds correct OAuth redirects and secure cookies.
    map $http_x_forwarded_proto $hermes_forwarded_proto {
        default $scheme;
        http    http;
        https   https;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    server {
        listen ${HERMES_LISTEN};
        server_name _;

        root "${HERMES_STATIC_ROOT}";
        index index.html;

        # Container runtime configuration must not outlive a gateway change.
        location = /gateway-config.js {
            add_header Cache-Control "no-store";
        }

        location = /runtime-config.js {
            add_header Cache-Control "no-store";
        }

        # Stable URLs change between releases. Always fetch the current shell,
        # worker scripts, and build identity instead of an intermediary's copy.
        location ~ ^/(?:index\.html|sw\.js|notifications-sw\.js|update-coordinator-sw\.js|manifest\.webmanifest|build-info\.json)$ {
            add_header Cache-Control "no-store" always;
            try_files $uri =404;
        }

        # Cache static build assets aggressively (content-hashed filenames).
        location /assets/ {
            expires 30d;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        # Standard Hermes socket compatibility belongs to the image's local service.
        location ^~ /api/athena/gateway/ {
            proxy_pass http://127.0.0.1:4181;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $hermes_forwarded_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
        }

        # Local preference storage verifies every request with Hermes.
        location ^~ /api/athena/android/ {
            client_max_body_size 8k;
            proxy_pass http://127.0.0.1:4181;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $hermes_forwarded_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
        }

        # Hermes permits this HTML landing page as a post-login destination.
        location = /android/sign-in {
            client_max_body_size 8k;
            proxy_pass http://127.0.0.1:4181;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $hermes_forwarded_proto;
        }

        location = /api/athena/preferences {
            client_max_body_size 2m;
            proxy_pass http://127.0.0.1:4181;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $hermes_forwarded_proto;
            proxy_read_timeout 15s;
        }

        # Hermes gateway — REST + WebSocket, same-origin (auth cookies/ws-tickets).
        location ~ ^(${HERMES_PROXY_ROUTES}) {
            proxy_pass ${HERMES_GATEWAY_URL};
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $hermes_forwarded_proto;
            proxy_ssl_server_name on;
            proxy_read_timeout 3600s;
        }

        # The mounted plugin service owns both directory metadata and file reads.
        location ~ ^/(?:plugins|desktop-plugins)(?:/|$) {
            proxy_pass http://127.0.0.1:4181;
            proxy_set_header Host $http_host;
        }

        # SPA fallback: any unknown route serves the app shell (hash-routed SPA).
        location / {
            add_header Cache-Control "no-cache" always;
            try_files $uri $uri/ /index.html;
        }
    }
}
