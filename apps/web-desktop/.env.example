# Copy to .env.hermes-web for Docker. Use placeholders only in this tracked file.
# Hermes Webapp must be enabled in /opt/data/config.yaml; see README.md.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=change-me
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-with-a-persistent-random-session-secret

# Keep the existing preference volume at this location when upgrading.
HERMES_PREFERENCES_DIR=/data/athena

# Migration only: set to your previous HERMES_GATEWAY_URL to retain its account
# preference and Android push namespace. This is an identity, not a dial target.
# ATHENA_PREFERENCES_IDENTITY_URL=http://previous-gateway.example:9119

# Local Vite development only (copy these into apps/web-desktop/.env):
# ATHENA_OFFICIAL_WEBAPP=1
# HERMES_GATEWAY_URL=http://127.0.0.1:9120
# WEB_ALLOWED_HOSTS=
