{
  "name": "athena",
  "private": true,
  "version": "0.1.1",
  "description": "Athena for Hermes Agent \u2014 web and mobile chat UI (PWA) with a nix-free Docker build.",
  "scripts": {
    "dev": "pnpm --filter web-desktop run dev",
    "build": "pnpm --filter web-desktop run build",
    "typecheck": "node scripts/typecheck.mjs",
    "legacy:stage-static-artifact": "bash apps/web-desktop/scripts/deploy.sh",
    "prepare:renderer": "node scripts/renderer.mjs",
    "check:renderer": "node scripts/renderer.mjs --check",
    "check:official-release": "node scripts/official-release.mjs",
    "check:renderer-dependencies": "node scripts/renderer-dependencies.mjs",
    "report:renderer-dependencies": "node scripts/renderer-dependencies.mjs --report",
    "check:upstream": "node scripts/renderer-compatibility-report.mjs",
    "inspect:renderer": "node scripts/inspect-renderer.mjs",
    "test:foundation": "node --test scripts/*.test.mjs",
    "check:compatibility-registry": "node scripts/compatibility-registry.mjs",
    "verify:behavior": "node scripts/verify-behavior.mjs",
    "docs:compatibility": "node scripts/compatibility-registry.mjs --write",
    "update:hermes": "node scripts/hermes-release.mjs",
    "sync:renderer-dependencies": "node scripts/renderer-dependencies.mjs --sync"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "web-push": "3.6.7",
    "ws": "8.22.2"
  }
}
