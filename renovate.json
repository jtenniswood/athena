{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Keep Gradle compatible with Android Gradle Plugin 8, which uses APIs removed in Gradle 9.6.",
      "matchManagers": ["gradle-wrapper"],
      "allowedVersions": "<9.6.0"
    },
    {
      "description": "Review renderer-sensitive libraries together with the pinned renderer baseline.",
      "matchPackageNames": [
        "@assistant-ui/core", "@assistant-ui/react", "@assistant-ui/react-streamdown",
        "@nanostores/react", "nanostores", "react", "react-dom", "react-router",
        "radix-ui", "@nous-research/ui", "@tanstack/react-virtual", "react-arborist",
        "streamdown", "@streamdown/code", "@streamdown/math", "react-shiki", "shiki",
        "use-stick-to-bottom", "typescript", "vite", "@vitejs/plugin-react"
      ],
      "groupName": "renderer compatibility"
    },
    {
      "description": "Align npm updates with pnpm's one-day release-age policy.",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day"
    }
  ]
}
