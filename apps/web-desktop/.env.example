# Local Vite configuration. Copy to apps/web-desktop/.env.
# Production chooses its existing Hermes server in compose.example.yml.
HERMES_GATEWAY_URL=http://127.0.0.1:9119
WEB_ALLOWED_HOSTS=

# Optional browser-hosted filesystem plugin roots; no Hermes server runs here.
HERMES_HOME=/data/hermes
# Persistent account preferences and Android bindings.
HERMES_PREFERENCES_DIR=/data/athena
