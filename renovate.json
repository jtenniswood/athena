{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Renderer dependencies advance with the verified Hermes release and explicit reviewed fixes.",
      "matchPackageNames": [
        "@assistant-ui/core",
        "@assistant-ui/react",
        "@assistant-ui/react-streamdown",
        "@audiowave/react",
        "@chenglou/pretext",
        "@codemirror/commands",
        "@codemirror/language",
        "@codemirror/language-data",
        "@codemirror/state",
        "@codemirror/view",
        "@dnd-kit/core",
        "@dnd-kit/sortable",
        "@dnd-kit/utilities",
        "@icons-pack/react-simple-icons",
        "@lezer/highlight",
        "@nanostores/react",
        "@nous-research/ui",
        "@novnc/novnc",
        "@streamdown/code",
        "@streamdown/math",
        "@tabler/icons-react",
        "@tailwindcss/typography",
        "@tailwindcss/vite",
        "@tanstack/react-query",
        "@tanstack/react-virtual",
        "@types/d3-force",
        "@types/hast",
        "@types/node",
        "@types/qrcode",
        "@types/react",
        "@types/react-dom",
        "@vitejs/plugin-react",
        "@vscode/codicons",
        "@xterm/addon-fit",
        "@xterm/addon-serialize",
        "@xterm/addon-unicode11",
        "@xterm/addon-web-links",
        "@xterm/addon-webgl",
        "@xterm/xterm",
        "blobatar",
        "class-variance-authority",
        "clsx",
        "cmdk",
        "d3-force",
        "dnd-core",
        "dompurify",
        "driver.js",
        "emojibase-data",
        "fflate",
        "frimousse",
        "hast-util-from-html-isomorphic",
        "hast-util-to-text",
        "ignore",
        "katex",
        "lucide-react",
        "motion",
        "nanostores",
        "node-pty",
        "pele",
        "qrcode",
        "radix-ui",
        "react",
        "react-arborist",
        "react-dnd-html5-backend",
        "react-dom",
        "react-router",
        "react-shiki",
        "remark-math",
        "remend",
        "shiki",
        "simple-git",
        "streamdown",
        "tailwind-merge",
        "tailwindcss",
        "tw-shimmer",
        "typescript",
        "unicode-animations",
        "unified",
        "unist-util-visit-parents",
        "use-stick-to-bottom",
        "vfile",
        "vite",
        "web-haptics"
      ],
      "groupName": "renderer compatibility",
      "enabled": false
    },
    {
      "description": "Align npm updates with pnpm's one-day release-age policy.",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "1 day"
    }
  ]
}
